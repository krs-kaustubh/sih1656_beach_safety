<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is 0 on purpose. Android's own widget refresh is
     capped at 30 minutes and would only ever replay whatever the app last
     saved, so the app pushes updates instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/lehar_widget"
    android:previewImage="@drawable/hero_low"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"/>
